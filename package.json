{
  "name": "tempura",
  "version": "0.4.1",
  "repository": "lukeed/tempura",
  "description": "A light, crispy, and delicious template engine",
  "type": "module",
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "license": "MIT",
  "author": {
    "name": "Luke Edwards",
    "email": "luke.edwards05@gmail.com",
    "url": "https://lukeed.com"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun bin && bunx --bun bundt --module",
    "test": "bunx --bun uvu test"
  },
  "files": [
    "*.d.ts",
    "esbuild",
    "rollup",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./esbuild": {
      "types": "./esbuild/index.d.ts",
      "default": "./esbuild/index.mjs"
    },
    "./rollup": {
      "types": "./rollup/index.d.ts",
      "default": "./rollup/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "modes": {
    "default": "src/index.js",
    "esbuild": "src/esbuild.js",
    "rollup": "src/rollup.js"
  },
  "keywords": [
    "engine",
    "mustache",
    "handlebars",
    "template",
    "html",
    "hbs"
  ],
  "devDependencies": {
    "bundt": "1.1.5",
    "uvu": "0.5.1"
  }
}
