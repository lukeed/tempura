{
  "name": "tempura",
  "version": "1.0.1",
  "repository": "lukeed/tempura",
  "description": "A light, crispy, and delicious template engine",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": {
    "name": "Luke Edwards",
    "email": "luke.edwards05@gmail.com",
    "url": "https://lukeed.com"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun build.ts",
    "check": "tsc",
    "test": "bunx --bun uvu test"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "engine",
    "mustache",
    "handlebars",
    "template",
    "html",
    "hbs"
  ],
  "devDependencies": {
    "@types/bun": "1.4.3",
    "esbuild": "0.28.2",
    "rolldown": "1.2.14",
    "typescript": "7.0.2",
    "uvu": "0.5.1",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "esbuild": "*",
    "rolldown": "*",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
